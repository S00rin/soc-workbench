# SOC Workbench environment configuration.
# Copy to ".env" (at the repo root) and adjust. NEVER commit your real .env.

# --- Core ---
APP_NAME=SOC Workbench
ENVIRONMENT=development
DEBUG=true

# --- Single-user login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Used to sign login tokens AND encrypt stored secrets / the tokenization map.
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Storage ---
# Defaults to <repo>/data. SQLite DB lives at data/app.db.
# DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/app.db

# --- CORS (frontend dev servers) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM (optional; can also be set in Settings UI, stored encrypted) ---
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# --- Optional OpenAI-compatible endpoint ---
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Claude Code tasks may only access this directory and descendants.
# CLAUDE_WORKSPACE_ROOT=/absolute/path/to/allowed/workspaces
